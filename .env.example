# InferPool 手动运行配置模板。程序不会自动加载此文件。
# 一键本地演示使用 npm run demo，无需填写本模板。
# 复制为 .env 后仅在本机设置；不要提交实际 .env 或 .local 凭证。

# Router 链适配：anvil 或 monad-testnet。
# Monad 测试网请同时修改 RPC_URL、合约地址、签名钱包和状态文件。
CHAIN_MODE=anvil
RPC_URL=http://127.0.0.1:18545
MARKET_ADDRESS=
TOKEN_ADDRESS=
ROUTER_ADDRESS=

# Monad 模式通过 Alchemy CLI 的现有 session 钱包签名。
# session 地址必须匹配 ROUTER_ADDRESS 与市场合约 router()。
# 不要为 Router 添加私钥环境变量；本模板不包含任何私钥示例值。

# Router HTTP 与身份挑战域名。需要公网时另行配置 HTTPS/WSS 入口。
HOST=127.0.0.1
PORT=8787
ROUTER_PUBLIC_URL=http://127.0.0.1:8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
REQUEST_TIMEOUT_MS=30000
ROUTER_STATE_PATH=.local/router-anvil.json

# 本地合约部署与 EVM 集成测试，仅允许回环地址和 chain ID 31337。
TEST_RPC_URL=http://127.0.0.1:18545

# 手动启动的独立卖家；两个进程应使用不同 ID、名称、端口和钱包。
# 卖家钱包需先在当前网络发布 mock-reasoner 的有效链上报价。
PROVIDER_ROUTER_URL=ws://127.0.0.1:8787/provider
PROVIDER_ID=seller-a
PROVIDER_NAME=Seller-A
PROVIDER_MODEL=mock-reasoner
PROVIDER_PORT=8791
PROVIDER_CAPACITY=2
PROVIDER_INTERVAL_MS=80
PROVIDER_CHUNK_SIZE=4
PROVIDER_MODE=normal

# 私钥只由本地环境或安全的秘密管理工具注入，勿写入提交的模板。
PROVIDER_PRIVATE_KEY=
# 显式临时身份可设置 true；重启会改变地址，且不自动发布链上报价。
PROVIDER_EPHEMERAL=false

# 以下为本地配置，不会修改链上报价。单价：DemoUSD / 百万模拟单位。
PROVIDER_INPUT_PRICE=30
PROVIDER_CACHE_READ_PRICE=3
PROVIDER_CACHE_WRITE_PRICE=37.5
PROVIDER_OUTPUT_PRICE=80
# 最低预留金额，非最低消费。
PROVIDER_MIN_RESERVE=0.01
