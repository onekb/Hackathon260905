# Install as /etc/systemd/system/inferpool-router.service (0644).
# Create /srv/inferpool/state as inferpool:inferpool (0700); keep router.env
# and the Linux-authorized Alchemy session files private (0600).
# Node 22 and @alchemy/cli 0.24.0 must already be installed at the paths below.
[Unit]
Description=InferPool Router and web export (Monad Testnet)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=inferpool
Group=inferpool
WorkingDirectory=/srv/inferpool/current
Environment="PATH=/opt/inferpool/node/bin:/opt/inferpool/tools/bin:/usr/local/bin:/usr/bin:/bin"
Environment=NODE_ENV=production
UMask=0077
ExecStartPre=/usr/bin/test -r /srv/inferpool/state/router.env
ExecStartPre=/usr/bin/test -x /opt/inferpool/tools/bin/alchemy
ExecStartPre=/usr/bin/test -r /srv/inferpool/state/alchemy/config.json
ExecStartPre=/usr/bin/test -r /srv/inferpool/current/contracts/out/InferenceMarket.sol/InferenceMarket.json
ExecStartPre=/usr/bin/test -r /srv/inferpool/current/web/out/index.html
ExecStart=/opt/inferpool/node/bin/node --env-file=/srv/inferpool/state/router.env --import tsx server/src/index.ts
Restart=on-failure
RestartSec=10s
# Quiesce new orders and await settlements before a planned restart. Give the
# Node parent time to collect an in-flight Alchemy child's result before the
# bounded stop timeout; interrupted transactions still require reconciliation.
KillMode=mixed
TimeoutStopSec=240s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/inferpool/state
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inferpool-router

[Install]
WantedBy=multi-user.target
