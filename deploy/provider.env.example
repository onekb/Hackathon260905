# Copy to /srv/inferpool/state/provider.env with mode 0600, owner inferpool.
# Authorize a new Alchemy CLI 0.24.0 session on Linux using this config path.
# The service explicitly selects --alchemy-session; do not set a private key,
# ephemeral mode, or browser-wallet identity in this file.
ALCHEMY_CONFIG=/srv/inferpool/state/alchemy/config.json
XDG_CONFIG_HOME=/srv/inferpool/state/config
XDG_CACHE_HOME=/srv/inferpool/state/cache

# The Router signs challenges for ROUTER_PUBLIC_URL's host (demo.example.com).
# A loopback ws:// URL would fail the Provider's exact domain check. Route
# through the public HTTPS proxy with a valid certificate and WS upgrade.
PROVIDER_ROUTER_URL=wss://demo.example.com/provider
PROVIDER_ID=seller-monad
PROVIDER_NAME="Monad 演示节点"
PROVIDER_MODEL=mock-reasoner
# The console always binds 127.0.0.1; do not expose/proxy this management port.
PROVIDER_PORT=8793
PROVIDER_CAPACITY=2
PROVIDER_INTERVAL_MS=80
PROVIDER_CHUNK_SIZE=4
PROVIDER_MODE=normal

# Local proposed prices per million mock Unicode tokens. The chain's published
# quote is authoritative; changing this file does not publish a new quote.
PROVIDER_INPUT_PRICE=30
PROVIDER_CACHE_READ_PRICE=3
PROVIDER_CACHE_WRITE_PRICE=37.5
PROVIDER_OUTPUT_PRICE=80
# Minimum reservation in DemoUSD, not a minimum charge.
PROVIDER_MIN_RESERVE=0.0001
