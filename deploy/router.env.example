# 2 concurrent globally and 10 attempts globally per fixed demo epoch.
# Set once to the actual public demo start time. Keep unchanged on restarts.
# Deliberately blank: the service must reject an unconfigured admission window.
DEMO_ADMISSION_START_UTC=
DEMO_NEW_ORDERS_ENABLED=true
